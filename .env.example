# Development-only values. Replace every secret before shared or production deployment.
POSTGRES_DB=vehicle_tracking
POSTGRES_USER=vehicle_app
POSTGRES_PASSWORD=change_me_local_only
REDIS_PASSWORD=change_me_local_only
SPRING_PROFILES_ACTIVE=local
# MQTT internal callback secret: generate a unique random value (32+ characters) before deployment.
MQTT_AUTH_SHARED_SECRET=replace_with_random_64_character_secret
# EMQX cluster node cookie: generate a separate random value before deployment.
EMQX_NODE_COOKIE=replace_with_another_random_cluster_cookie
